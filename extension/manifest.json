{
  "manifest_version": 3,
  "name": "Placify Secure Assessment Monitor",
  "version": "1.0.0",
  "description": "Companion integrity monitor for the Placify Secure Assessment Platform.",
  "permissions": [
    "tabs",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://localhost:5173/*",
    "http://localhost:5174/*",
    "http://localhost:5175/*",
    "http://localhost:3000/*",
    "http://localhost:8000/*",
    "http://localhost:8001/*",
    "http://127.0.0.1/*",
    "http://127.0.0.1:5173/*",
    "http://127.0.0.1:5174/*",
    "http://127.0.0.1:8000/*",
    "http://127.0.0.1:8001/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://localhost:5173/*",
        "http://localhost:5174/*",
        "http://localhost:5175/*",
        "http://localhost:3000/*",
        "http://localhost:8000/*",
        "http://localhost:8001/*",
        "http://127.0.0.1/*",
        "http://127.0.0.1:5173/*",
        "http://127.0.0.1:5174/*",
        "http://127.0.0.1:8000/*",
        "http://127.0.0.1:8001/*",
        "https://*/*",
        "http://*/*",
        "<all_urls>"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
